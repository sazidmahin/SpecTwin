DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/srs_diagram_platform
SECRET_KEY=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_DELIVERY_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@srs-platform.local
SMTP_FROM_NAME=SRS Diagram Platform
SMTP_USE_TLS=true
# Set EMAIL_DELIVERY_MODE=resend to send verification emails through Resend (https://resend.com).
# RESEND_FROM_EMAIL must use a domain verified in Resend; onboarding@resend.dev
# only delivers to your own Resend account email (good for testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=SRS Diagram Platform
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Workspace invitation emails link to FRONTEND_URL/#/invite/<token>.
FRONTEND_URL=http://localhost:5173
WORKSPACE_INVITATION_EXPIRE_DAYS=7
OPENAI_MODEL=gpt-5.6
OPENAI_MODELS=gpt-5.6,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.5-2026-04-23,gpt-5.4,gpt-5.4-2026-03-05,gpt-5.4-pro,gpt-5.4-mini,gpt-5.2,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,gpt-4o,gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODELS=claude-fable-5,claude-opus-5,claude-sonnet-5,claude-haiku-4-5-20251001,claude-opus-4-8,claude-opus-4-7,claude-opus-4-6,claude-sonnet-4-6
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=0
# Local AI via an Ollama server (no API key). In Docker this is http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODELS=llama3.2:1b,llama3.2,qwen2.5:1.5b,qwen2.5:3b,llama3.1,qwen2.5,mistral,phi3
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=600
# CPU-friendly defaults for local models on a CPU-only laptop.
# One fixed context window: changing it between calls makes Ollama reload the model.
OLLAMA_NUM_CTX=8192
# Default output budget; each pipeline task also sets its own smaller/larger budget.
OLLAMA_NUM_PREDICT=1024
# Long input is split into chunks of at most this many tokens per call.
OLLAMA_CHUNK_TOKENS=2000
# Keep the model loaded between stages (reloading costs seconds on a CPU).
OLLAMA_KEEP_ALIVE=30m
# CPU threads; leave empty to let Ollama decide (usually = physical cores).
OLLAMA_NUM_THREAD=
# Hosted "AI generation" engine: one platform key serves every user (no user key needed).
# Leave OPENROUTER_API_KEY empty to hide the engine. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional comma-separated fallbacks tried when the primary model is busy/down.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_TOKENS=4096
# Retries for a timeout, a 5xx or an error served with HTTP 200.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_SITE_URL=
# Correction memory: a fix a user makes to an AI-generated artifact is stored and
# fed back the next time similar input is generated, so the same mistake is not
# repeated. Off by default - turning it on stores corrections per workspace.
RAG_ENABLED=false
RAG_TOP_K=2
RAG_MIN_SIMILARITY=0.55
# Which embedder scores "similar input": auto uses Ollama when it is reachable
# and otherwise the built-in lexical one, which needs no model or network - set
# it to ollama or lexical to pin one. Vectors from the two are never compared.
RAG_EMBEDDER=auto
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-production-secret
SRSGEN_BASE_MODEL=Qwen/Qwen1.5-1.8B-Chat
SRSGEN_ARTIFACT_PATH=model_artifacts/srsgen-qwen1.5
SRSGEN_LOAD_IN_4BIT=true
SRSGEN_MAX_NEW_TOKENS=2048
SRSGEN_TEMPERATURE=0
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=



BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
